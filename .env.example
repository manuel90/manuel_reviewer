# Target GitHub username assigned to PRs that should trigger AI code reviews
TARGET_ASSIGNEE=your_github_username

# Incoming Slack Webhook URL for interactive approval prompts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini Model (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# GitHub Personal Access Token (Requires pull-requests:write or repo scope)
GITHUB_TOKEN=ghp_your_github_token_here

# Slack App-Level Token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Slack Bot User OAuth Token for Socket Mode (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Optional: Custom Webhook Server URL for simulate_pr script
WEBHOOK_SERVER_URL=http://localhost:8000/webhook
